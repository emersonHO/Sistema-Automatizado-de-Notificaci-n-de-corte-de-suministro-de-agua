# Copiar a .env.docker (no versionar). Credenciales SOLO para la BD Docker.
# No reutilizar la contraseña del PostgreSQL de Windows.

POSTGRES_USER=agua
POSTGRES_PASSWORD=cambiar_password_docker
POSTGRES_DB=notificaciones_agua

SESSION_SECRET=cambiar_sesion_larga_aleatoria
ADMIN_USER=admin
ADMIN_PASSWORD=admin

API_URL=https://cortedeagua.net.pe/api.php
API_DIAS=14
ZONA_SISTEMA=America/Lima
BASE_URL=http://127.0.0.1:8000
# true = ciudadanos reales. Exige SMTP real. El script iniciar-publico actualiza BASE_URL con trycloudflare.
OPERACION_PUBLICA=false

SMTP_ENABLED=false
MODO_ENVIO=simulacion
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_TIMEOUT=20
SMTP_FROM=notificaciones@localhost
SMTP_FROM_NAME=Avisos de agua Lima
ADMIN_ALERT_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
# Laboratorio: SMTP_ENABLED=true y MODO_ENVIO=mailpit → http://127.0.0.1:8025 (no llega a Internet).
# Ciudadanos: SMTP_ENABLED=true, MODO_ENVIO=real, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true
# y contraseña de aplicación en SMTP_PASSWORD. Nunca versionar secretos.
# Con OPERACION_PUBLICA=true, si SMTP no está listo el sistema NO finge el envío.

LOG_FORMAT=json

INTERNAL_API_TOKEN=cambiar_token_interno_largo
# true solo para la prueba n8n con captura_minima.json; en operación déjelo false.
INTERNAL_PERMITIR_FIXTURE=false
WORKER_POLL_S=2
NOTIF_POLL_S=2
NOTIF_MAX_INTENTOS=5
NOTIF_LOTE=20
NOTIF_BACKOFF_BASE_S=5
NOTIF_SIMULAR_FALLO=false

N8N_ENCRYPTION_KEY=cambiar_cifrado_n8n_largo
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
