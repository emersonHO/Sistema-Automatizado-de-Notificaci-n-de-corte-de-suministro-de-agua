# Copiar a .env.docker (no versionar). Credenciales SOLO para la BD Docker.
# No reutilizar la contraseña del PostgreSQL de Windows.

POSTGRES_USER=agua
POSTGRES_PASSWORD=cambiar_password_docker
POSTGRES_DB=notificaciones_agua

SESSION_SECRET=cambiar_sesion_larga_aleatoria
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_admin

API_URL=https://cortedeagua.net.pe/api.php
API_DIAS=14
ZONA_SISTEMA=America/Lima
BASE_URL=http://127.0.0.1:8000

SMTP_ENABLED=false
MODO_ENVIO=simulacion
SMTP_FROM=notificaciones@localhost

LOG_FORMAT=json
