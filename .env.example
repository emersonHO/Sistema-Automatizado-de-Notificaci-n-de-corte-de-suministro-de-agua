# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notificaciones_agua
DB_USER=postgres
DB_PASSWORD=cambiar

# Fuente pública de un tercero (no es API oficial de SEDAPAL)
API_URL=https://cortedeagua.net.pe/api.php
API_DIAS=14
API_TIMEOUT=30
API_REINTENTOS=3

# Sistema
ZONA_SISTEMA=America/Lima
BASE_URL=http://127.0.0.1:8000
ADMIN_TOKEN=

# Correo: desactivado por defecto. No envíe a destinatarios reales en pruebas.
SMTP_ENABLED=false
MODO_ENVIO=simulacion
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@localhost
SMTP_STARTTLS=true
