# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notificaciones_agua
DB_USER=postgres
DB_PASSWORD=cambiar

# Fuente pública de un tercero (no es API oficial de SEDAPAL)
API_URL=https://cortedeagua.net.pe/api.php
API_DIAS=14
API_TIMEOUT=30
API_REINTENTOS=3

# Sistema
ZONA_SISTEMA=America/Lima
BASE_URL=http://127.0.0.1:8000
ADMIN_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=cambiar_sesion
WEB_HOST=127.0.0.1
WEB_PORT=8000
LOG_FORMAT=text
LOG_LEVEL=INFO

# Correo: desactivado por defecto. No envíe a destinatarios reales en pruebas.
SMTP_ENABLED=false
MODO_ENVIO=simulacion
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@localhost
SMTP_STARTTLS=true
SMTP_TIMEOUT=20

INTERNAL_API_TOKEN=
INTERNAL_PERMITIR_FIXTURE=false
WORKER_POLL_S=2
NOTIF_POLL_S=2
NOTIF_MAX_INTENTOS=5
NOTIF_LOTE=20
NOTIF_BACKOFF_BASE_S=5
NOTIF_SIMULAR_FALLO=false
