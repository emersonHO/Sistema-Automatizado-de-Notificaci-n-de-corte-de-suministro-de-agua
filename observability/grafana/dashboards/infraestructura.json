{
  "uid": "agua-infra",
  "title": "Infraestructura (proceso web)",
  "timezone": "utc",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Memoria residente del proceso web (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "process_resident_memory_bytes", "refId": "A" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "CPU del proceso web (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(process_cpu_seconds_total[5m])", "refId": "A" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Latencia HTTP (p95)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))",
        "legendFormat": "{{handler}}",
        "refId": "A"
      }]
    }
  ]
}
