# Pegue estas claves en el Web Service de Render → Environment.
# NO cree DATABASE_URL aquí a mano (si la deja vacía, el arranque falla).
# Esa clave la crea Render cuando enlaza PostgreSQL (paso 4 de la guía).
# NO copie .env.docker ni DB_HOST=localhost.

DB_SSLMODE=require

BASE_URL=https://sedapal-notificaciones-mvp.onrender.com/
OPERACION_PUBLICA=true
SESSION_HTTPS=true
TRUST_PROXY=true
PROTEGER_METRICS=true
WEB_HOST=0.0.0.0

SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=
INTERNAL_API_TOKEN=
INTERNAL_PERMITIR_FIXTURE=false

API_URL=https://cortedeagua.net.pe/api.php
API_DIAS=
ZONA_SISTEMA=America/Lima

CORREO_PROVEEDOR=resend
MODO_ENVIO=real
SMTP_ENABLED=false
RESEND_API_KEY=
SMTP_FROM=onboarding@resend.dev
SMTP_FROM_NAME=Avisos de agua Lima
ADMIN_ALERT_EMAIL=

LOG_FORMAT=json
LOG_LEVEL=INFO
CAPTURAR_AL_ARRANCAR=true
