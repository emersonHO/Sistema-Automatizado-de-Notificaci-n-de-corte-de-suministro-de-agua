# Variables para el Web Service de Render (Dashboard → Environment).
# No pegue secretos reales en Git. Este archivo es solo plantilla.

# Render inyecta PORT. DATABASE_URL solo aparece si ENLAZA el Postgres al Web Service
# (Environment → Add from PostgreSQL). No use localhost.
# Web: Internal Database URL. GitHub Actions / backups: External Database URL.

DATABASE_URL=
DB_SSLMODE=require

BASE_URL=https://SU-SERVICIO.onrender.com
OPERACION_PUBLICA=true
SESSION_HTTPS=true
TRUST_PROXY=true
PROTEGER_METRICS=true
WEB_HOST=0.0.0.0

SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=
INTERNAL_API_TOKEN=
INTERNAL_PERMITIR_FIXTURE=false

API_URL=https://cortedeagua.net.pe/api.php
API_DIAS=
ZONA_SISTEMA=America/Lima

# Resend (HTTPS). Render Free bloquea SMTP 25/465/587.
CORREO_PROVEEDOR=resend
MODO_ENVIO=real
SMTP_ENABLED=false
RESEND_API_KEY=
SMTP_FROM=Avisos <onboarding@resend.dev>
SMTP_FROM_NAME=Avisos de agua Lima
ADMIN_ALERT_EMAIL=

LOG_FORMAT=json
LOG_LEVEL=INFO
