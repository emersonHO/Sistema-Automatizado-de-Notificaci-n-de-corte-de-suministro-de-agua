# Copiar a .env.production en el VPS. No versionar.
DOMINIO=avisos.ejemplo.edu.pe
CADDY_EMAIL=admin@ejemplo.edu.pe
BASE_URL=https://avisos.ejemplo.edu.pe

POSTGRES_USER=agua
POSTGRES_PASSWORD=generar_con_openssl
POSTGRES_DB=notificaciones_agua

SESSION_SECRET=generar_con_openssl
SESSION_HTTPS=true
ADMIN_USER=admin
ADMIN_PASSWORD=generar_con_openssl
INTERNAL_API_TOKEN=generar_con_openssl
N8N_ENCRYPTION_KEY=generar_con_openssl
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generar_con_openssl

API_URL=https://cortedeagua.net.pe/api.php
API_DIAS=
ZONA_SISTEMA=America/Lima
LOG_FORMAT=json
INTERNAL_PERMITIR_FIXTURE=false

SMTP_ENABLED=false
MODO_ENVIO=real
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_TIMEOUT=20
SMTP_FROM=avisos@ejemplo.edu.pe
SMTP_FROM_NAME=Avisos de agua Lima
SMTP_USER=
SMTP_PASSWORD=
ADMIN_ALERT_EMAIL=

WORKER_POLL_S=2
NOTIF_POLL_S=2
NOTIF_MAX_INTENTOS=5
NOTIF_LOTE=20
NOTIF_BACKOFF_BASE_S=5
NOTIF_SIMULAR_FALLO=false
TOKEN_HORAS_CONFIRMACION=48
TOKEN_HORAS_GESTION=720
PUBLIC_REVELAR_ENLACE=false
