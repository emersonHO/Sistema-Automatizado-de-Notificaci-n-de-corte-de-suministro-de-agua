{
  "name": "Pipeline interrupciones — manual (fixture)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Lima"
  },
  "notes": "Prueba de laboratorio: modo=fixture (captura_minima.json). No llama a la API pública. Requiere INTERNAL_PERMITIR_FIXTURE=true en el servicio web. Auth: credencial Header Auth «FastAPI interno».",
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Inicio manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://web:8000/internal/v1/pipeline/ejecuciones",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "=n8n-{{$workflow.id}}-{{$execution.id}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"origen\": \"MANUAL\",\n  \"solo_si_libre\": false,\n  \"modo\": \"fixture\",\n  \"ruta_fixture\": \"captura_minima.json\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Encolar pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "fastapi-interno",
          "name": "FastAPI interno"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "inicio",
              "name": "inicio_ms",
              "value": "={{Date.now()}}",
              "type": "number"
            },
            {
              "id": "sid",
              "name": "solicitud_id",
              "value": "={{$json.solicitud_id}}",
              "type": "number"
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Guardar solicitud",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Esperar 10s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 0]
    },
    {
      "parameters": {
        "url": "=http://web:8000/internal/v1/pipeline/ejecuciones/{{ $('Guardar solicitud').item.json.solicitud_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Consultar estado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "fastapi-interno",
          "name": "FastAPI interno"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "terminal",
              "leftValue": "={{['COMPLETADO','COMPLETADO_INCOMPLETO','ERROR','ERROR_RECUPERACION','CANCELADA'].includes($json.estado)}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "¿Estado terminal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "timeout",
              "leftValue": "={{Date.now() - $('Guardar solicitud').item.json.inicio_ms}}",
              "rightValue": 900000,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "¿Timeout 15 min?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 220]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg",
              "name": "mensaje",
              "value": "No se obtuvo un estado terminal en 15 minutos. La solicitud y el pipeline no se cancelan. Consulte el mismo solicitud_id más tarde.",
              "type": "string"
            },
            {
              "id": "sid2",
              "name": "solicitud_id",
              "value": "={{$('Guardar solicitud').item.json.solicitud_id}}",
              "type": "number"
            },
            {
              "id": "est",
              "name": "estado",
              "value": "={{$json.estado}}",
              "type": "string"
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Espera agotada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 320]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "ok",
              "value": "={{$json.estado === 'COMPLETADO' || $json.estado === 'COMPLETADO_INCOMPLETO'}}",
              "type": "boolean"
            },
            {
              "id": "estado",
              "name": "estado",
              "value": "={{$json.estado}}",
              "type": "string"
            },
            {
              "id": "sid3",
              "name": "solicitud_id",
              "value": "={{$json.solicitud_id}}",
              "type": "number"
            },
            {
              "id": "eid",
              "name": "ejecucion_id",
              "value": "={{$json.ejecucion_id}}",
              "type": "number"
            },
            {
              "id": "err",
              "name": "mensaje_error",
              "value": "={{$json.mensaje_error}}",
              "type": "string"
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Resultado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "exito",
              "leftValue": "={{$json.ok}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "¿Proceso OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "errorMessage": "=Pipeline en {{$json.estado}}: {{$json.mensaje_error}}"
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Fallo del pipeline",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1760, 160]
    }
  ],
  "connections": {
    "Inicio manual": {
      "main": [[{ "node": "Encolar pipeline", "type": "main", "index": 0 }]]
    },
    "Encolar pipeline": {
      "main": [[{ "node": "Guardar solicitud", "type": "main", "index": 0 }]]
    },
    "Guardar solicitud": {
      "main": [[{ "node": "Esperar 10s", "type": "main", "index": 0 }]]
    },
    "Esperar 10s": {
      "main": [[{ "node": "Consultar estado", "type": "main", "index": 0 }]]
    },
    "Consultar estado": {
      "main": [[{ "node": "¿Estado terminal?", "type": "main", "index": 0 }]]
    },
    "¿Estado terminal?": {
      "main": [
        [{ "node": "Resultado", "type": "main", "index": 0 }],
        [{ "node": "¿Timeout 15 min?", "type": "main", "index": 0 }]
      ]
    },
    "¿Timeout 15 min?": {
      "main": [
        [{ "node": "Espera agotada", "type": "main", "index": 0 }],
        [{ "node": "Esperar 10s", "type": "main", "index": 0 }]
      ]
    },
    "Resultado": {
      "main": [[{ "node": "¿Proceso OK?", "type": "main", "index": 0 }]]
    },
    "¿Proceso OK?": {
      "main": [
        [],
        [{ "node": "Fallo del pipeline", "type": "main", "index": 0 }]
      ]
    }
  }
}
